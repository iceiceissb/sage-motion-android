# OpenAI credentials are server-only. Never copy this value into Android local.properties.
OPENAI_API_KEY=
SAGE_OPENAI_MODEL=gpt-5.6-terra
SAGE_OPENAI_REASONING_EFFORT=low
SAGE_OPENAI_TIMEOUT_SECONDS=45

# development may leave this empty. production refuses to start without it.
# For a public mobile release, replace a shared token with short-lived user/device auth at the gateway.
SAGE_BACKEND_AUTH_TOKEN=
SAGE_ENV=development
SAGE_LOG_LEVEL=INFO
SAGE_RATE_LIMIT_PER_MINUTE=30
SAGE_MAX_TOOL_ROUNDS=4
SAGE_MAX_TOOL_CALLS=8
